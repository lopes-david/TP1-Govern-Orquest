{
  "Comment": "CloudMart Pipeline: Ingestão → Transformação dbt → Quality Gate → Atualização de Views",
  "StartAt": "Ingestao",
  "States": {

    "Ingestao": {
      "Type": "Task",
      "Comment": "Etapa 1 – Lê CSVs da raw-zone e grava Parquet na bronze-zone",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "cloudmart-rawtobronze",
        "Arguments": {
          "--RAW_BUCKET.$":    "$.raw_bucket",
          "--BRONZE_BUCKET.$": "$.bronze_bucket"
        }
      },
      "ResultPath": "$.ingestao_result",
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotificarFalha",
          "ResultPath": "$.error"
        }
      ],
      "Next": "TransformacaoDbt"
    },

    "TransformacaoDbt": {
      "Type": "Task",
      "Comment": "Etapa 2 – Aplica regras dbt: qualidade, enriquecimento e joins (bronze→silver)",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "cloudmart-bronzetosilvervendas",
        "Arguments": {
          "--BRONZE_BUCKET.$": "$.bronze_bucket",
          "--SILVER_BUCKET.$": "$.silver_bucket"
        }
      },
      "ResultPath": "$.dbt_result",
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotificarFalha",
          "ResultPath": "$.error"
        }
      ],
      "Next": "QualityGate"
    },

    "QualityGate": {
      "Type": "Task",
      "Comment": "Etapa 2b – Verifica qualidade dos dados bronze e silver. Interrompe o pipeline se a taxa de erro ultrapassar os limiares: 0% integridade/negócio, 5% completude.",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "cloudmart-qualitygate",
        "Arguments": {
          "--BRONZE_BUCKET.$":  "$.bronze_bucket",
          "--SILVER_BUCKET.$":  "$.silver_bucket",
          "--REPORT_BUCKET.$":  "$.report_bucket"
        }
      },
      "ResultPath": "$.quality_gate_result",
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotificarFalhaQualidade",
          "ResultPath": "$.error"
        }
      ],
      "Next": "AtualizacaoViews"
    },

    "AtualizacaoViews": {
      "Type": "Task",
      "Comment": "Etapa 3a – Agrega KPIs na gold-zone (silver→gold)",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "cloudmart-silvertogoldrelatorio",
        "Arguments": {
          "--SILVER_BUCKET.$": "$.silver_bucket",
          "--GOLD_BUCKET.$":   "$.gold_bucket",
          "--ANO.$":           "$.ano"
        }
      },
      "ResultPath": "$.gold_result",
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotificarFalha",
          "ResultPath": "$.error"
        }
      ],
      "Next": "IniciarCrawler"
    },

    "IniciarCrawler": {
      "Type": "Task",
      "Comment": "Etapa 3b – Dispara o Glue Crawler para atualizar o catálogo Athena",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "silver-zone-crawler"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["Glue.CrawlerRunningException"],
          "Next": "AguardarCrawler",
          "ResultPath": null
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotificarFalha",
          "ResultPath": "$.error"
        }
      ],
      "Next": "AguardarCrawler"
    },

    "AguardarCrawler": {
      "Type": "Wait",
      "Comment": "Aguarda 30 segundos antes de verificar o status do crawler",
      "Seconds": 30,
      "Next": "VerificarCrawler"
    },

    "VerificarCrawler": {
      "Type": "Task",
      "Comment": "Consulta o status atual do Glue Crawler",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "silver-zone-crawler"
      },
      "ResultPath": "$.crawler_status",
      "Next": "CrawlerConcluido"
    },

    "CrawlerConcluido": {
      "Type": "Choice",
      "Comment": "Verifica se o crawler terminou ou ainda está rodando",
      "Choices": [
        {
          "Variable": "$.crawler_status.Crawler.State",
          "StringEquals": "RUNNING",
          "Next": "AguardarCrawler"
        },
        {
          "Variable": "$.crawler_status.Crawler.State",
          "StringEquals": "STOPPING",
          "Next": "AguardarCrawler"
        }
      ],
      "Default": "Sucesso"
    },

    "Sucesso": {
      "Type": "Succeed",
      "Comment": "Pipeline executado com sucesso — catálogo Athena atualizado"
    },

    "NotificarFalhaQualidade": {
      "Type": "Task",
      "Comment": "Publica alerta específico para falha no Quality Gate com detalhes dos testes reprovados",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn.$": "$.sns_topic_arn",
        "Subject": "CloudMart Pipeline — FALHA NO QUALITY GATE",
        "Message.$": "States.Format('Quality Gate reprovado: taxa de erro acima do limiar aceitável. Erro: {}. Verifique o relatório em s3://report-bucket/quality-reports/', States.JsonToString($.error))"
      },
      "ResultPath": null,
      "Next": "Falha"
    },

    "NotificarFalha": {
      "Type": "Task",
      "Comment": "Publica alerta no SNS com detalhes da falha",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn.$": "$.sns_topic_arn",
        "Subject": "CloudMart Pipeline — FALHA",
        "Message.$": "States.Format('Falha na etapa {}. Erro: {}', $$.State.Name, States.JsonToString($.error))"
      },
      "ResultPath": null,
      "Next": "Falha"
    },

    "Falha": {
      "Type": "Fail",
      "Error": "PipelineError",
      "Cause": "Uma etapa do pipeline falhou. Verifique o SNS e os logs do CloudWatch."
    }
  }
}

{
  "Comment": "CloudMart Data Pipeline: raw → bronze → silver → gold",
  "StartAt": "RawToBronze",
  "States": {
    "RawToBronze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "cloudmart-rawtobronze",
        "Arguments": {
          "--RAW_BUCKET.$":    "$.raw_bucket",
          "--BRONZE_BUCKET.$": "$.bronze_bucket"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "BronzeToSilver"
    },
    "BronzeToSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "cloudmart-bronzetosilvervendas",
        "Arguments": {
          "--BRONZE_BUCKET.$": "$.bronze_bucket",
          "--SILVER_BUCKET.$": "$.silver_bucket"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "SilverToGold"
    },
    "SilverToGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "cloudmart-silvertogoldrelatorio",
        "Arguments": {
          "--SILVER_BUCKET.$": "$.silver_bucket",
          "--GOLD_BUCKET.$":   "$.gold_bucket",
          "--ANO.$":           "$.ano"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotifyFailure",
          "ResultPath": "$.error"
        }
      ],
      "Next": "PipelineSuccess"
    },
    "PipelineSuccess": {
      "Type": "Succeed"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn.$": "$.sns_topic_arn",
        "Message.$": "States.Format('Pipeline falhou na etapa: {}. Erro: {}', $$.State.Name, $.error)"
      },
      "Next": "PipelineFailed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineError",
      "Cause": "Um ou mais Glue Jobs falharam. Verifique os logs no CloudWatch."
    }
  }
}
